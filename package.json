    "react-dom": "^18.3.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
